# Copy to .env and configure per environment.
ENVIRONMENT=development
API_GATEWAY_PORT=8000
DOCTOR_DASHBOARD_PORT=3000
KIOSK_FRONTEND_PORT=5173
DATABASE_URL=postgresql+psycopg://medikiosk:CHANGE_ME@postgres/medikiosk
MEDIKIOSK_DB_PASSWORD=
# Must be false in every environment that contains real patient information.
MOCK_EXTERNAL_SERVICES=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KIOSK_API_KEY=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ISSUER=http://localhost:8080/realms/medikiosk
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/medikiosk/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=medikiosk-api
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
BHASHINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
